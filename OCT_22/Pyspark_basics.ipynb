from pyspark.sql import SparkSession
spark=SparkSession.builder \
 .appName("Pyspark Training") \
.getOrCreate() 

print(spark)
print(spark.version)
----------------------------------------------
--Data Frames 
data = [
    (101, "Laptop", "Electronics", 65000),
    (102, "Mouse", "Accessories", 1500),
    (103, "Monitor", "Electronics", 18000),
    (104, "Office Chair", "Furniture", 9000),
    (105, "Keyboard", "Accessories", 3000)
]
columns=["product_id","product_name","category","price"]
--Creating DF using spark 
df=spark.createDataFrame(data,columns)
#displaying all records 
df.show()
#displaying Schema 
df.printSchema()
#Displaying all columns 
print(df.columns)
#Displaying only product name and price
df.select("product_name","price").show()
#Displaying products whose price is > 10000
df.filter(df.price>10000).show()
#Displaying products beloging to Electronics whose price is above 20000
df.filter((df.category=="Electronics")&(df.price>20000)).show()
